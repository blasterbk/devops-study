            ```text
            Pod Created
            
            ↓
            
            Scheduler Chooses Node
            
            ↓
            
            kubelet
            
            ↓
            
            Read RuntimeClass
            
            ↓
            
            Read Handler
            
            ↓
            
            CRI Request
            
            ↓
            
            containerd
            
            ↓
            
            Select Runtime
            
            ↓
            
            RunPodSandbox()
            
            ↓
            
            Create Container
            
            ↓
            
            Application Running
            ```
            
