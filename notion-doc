                                │
            
                              CRI
            
                                │
            
                                ▼
            
                         CRI Plugin
            
                                │
            
                    ┌───────────┼───────────┐
            
                    ▼           ▼           ▼
            
               Image Service  Metadata   Snapshot
            
                                │
            
                                ▼
            
                          Task Manager
            
                                │
            
                                ▼
            
                         Runtime Manager
            
                                │
            
                                ▼
            
                        containerd-shim
            
                                │
            
                                ▼
            
                              runc
            ```
            
