            ↓
            
            Deployment
            
            ↓
            
            Deployment Controller
            
            ↓
            
            ReplicaSet Created
            
            ↓
            
            ReplicaSet Informer
            
            ↓
            
            WorkQueue
            
            ↓
            
            ReplicaSet Worker
            
            ↓
            
            Reconcile
            
            ↓
            
            Count Pods
            
            ↓
            
            Need More?
            
            ↓
            
            Create Pod
            
            ↓
            
            API Server
            
            ↓
            
            Scheduler
            
            ↓
            
            Node
            
            ↓
            
            kubelet
            
            ↓
            
            Container Running
            ```
            
